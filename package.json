{
  "name": "ai-karaoke-transcriber",
  "version": "1.0.0",
  "description": "AI Karaoke Transcriber Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.aikaraoke.transcriber",
    "productName": "AI Karaoke Transcriber",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../backend/faster-whisper/dist/backend.exe",
        "to": "backend/backend.exe"
      },
      {
        "from": "../aicode/out",
        "to": "frontend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}